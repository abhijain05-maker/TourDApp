{
  "manifest_version": 3,
  "name": "QuickDev Recorder",
  "description": "Records what you do in a SAPUI5 / Fiori app, exactly as UI5 sees it, and sends it to QuickDev to build guided tours and wdi5 tests.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": ["scripting", "storage", "sidePanel", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "QuickDev Recorder",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
