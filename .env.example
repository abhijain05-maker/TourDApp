# Copy to .env (never commit .env). Keys stay on the server and are never sent to the browser.

# Default provider for tour generation: rules | gemini | sap-ai-core
# (the designer can pick another one per run; "rules" needs no AI and no key)
TOURD_LLM_PROVIDER=rules

# --- Google Gemini ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- SAP Generative AI Hub (AI Core orchestration) -------------------------------------------
# On BTP use the service binding. Locally: the AI Core service key as one line of JSON.
AICORE_SERVICE_KEY=
# A model deployed in your AI Core resource group (there is no useful default)
AICORE_MODEL=
AICORE_RESOURCE_GROUP=

# --- Privacy / operations --------------------------------------------------------------------
# Source code is sent to the chosen provider. Comments and secret-looking values are removed first;
# set TOURD_REDACT=0 to send the files unchanged.
TOURD_REDACT=1
# Turn AI off completely (only the rule-based generator remains) or per provider (comma separated ids)
TOURD_DISABLE_AI=0
TOURD_DISABLED_PROVIDERS=
# Approximate token budget for source code in the prompt (the inventory is always sent)
TOURD_TOKEN_BUDGET=60000

# --- Access ----------------------------------------------------------------------------------
# TourD has no login and only answers for localhost / 127.0.0.1 / [::1]. To reach it by another host name
# (only behind your own authentication) list the names, or * for any name.
TOURD_ALLOWED_HOSTS=
