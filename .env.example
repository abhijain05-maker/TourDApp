# QuickDev / QuickTest settings. Copy this file to .env (never commit .env) and fill in what you use.
# Keys stay on the server and are never sent to the browser. Restart the server after changing .env.
# Without any key everything still works: tours and tests come from rules, and QuickTest drafts by rules.
# After restarting, open QuickTest > a project > Setup and press "Test connection" next to a provider to check it.

# --- Which AI is the default ------------------------------------------------------------------
# rules | gemini | sap-ai-core
# Used for tour generation when nothing else is chosen. QuickTest has its own choice in the header
# (remembered per browser); a provider that is not set up below is greyed out there.
TOURD_LLM_PROVIDER=rules

# --- Google Gemini ----------------------------------------------------------------------------
# A key from https://aistudio.google.com/apikey - the Gemini API must be enabled for it.
# Example: GEMINI_API_KEY=AIza...(about 39 characters)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- SAP Generative AI Hub (AI Core orchestration) --------------------------------------------
# On BTP (Cloud Foundry) nothing is needed here: bind the AI Core service instead (see mta.yaml).
# Locally give the AI Core service key in ONE of these two ways:
#   a) the path of the key file you downloaded from the BTP cockpit (service key of the "aicore" instance)
#      Example: AICORE_SERVICE_KEY_FILE=C:\Users\you\keys\aicore-key.json
AICORE_SERVICE_KEY_FILE=
#   b) the same JSON pasted as ONE line
#      Example: AICORE_SERVICE_KEY={"clientid":"sb-...","clientsecret":"...","url":"https://<subaccount>.authentication.<region>.hana.ondemand.com","serviceurls":{"AI_API_URL":"https://api.ai.prod.<region>.aws.ml.hana.ondemand.com"}}
AICORE_SERVICE_KEY=
# A model that is DEPLOYED in your AI Core resource group (no default: the name depends on your deployments)
# Examples: gpt-4o | gemini-2.5-flash | anthropic--claude-3.5-sonnet
AICORE_MODEL=
# Only if you do not use the "default" resource group
AICORE_RESOURCE_GROUP=

# --- Privacy / operations ---------------------------------------------------------------------
# Source code is sent to the chosen provider. Comments and secret-looking values are removed first;
# set TOURD_REDACT=0 to send the files unchanged.
TOURD_REDACT=1
# Turn AI off completely (only the rule-based generator remains) or per provider (comma separated ids)
TOURD_DISABLE_AI=0
# Example: TOURD_DISABLED_PROVIDERS=gemini
TOURD_DISABLED_PROVIDERS=
# Approximate token budget for source code in the prompt (the inventory is always sent)
TOURD_TOKEN_BUDGET=60000

# --- Access -----------------------------------------------------------------------------------
# QuickDev has no login and only answers for localhost / 127.0.0.1 / [::1]. To reach it by another host name
# (only behind your own authentication) list the names, or * for any name.
# Example: TOURD_ALLOWED_HOSTS=quickdev.example.com
TOURD_ALLOWED_HOSTS=
