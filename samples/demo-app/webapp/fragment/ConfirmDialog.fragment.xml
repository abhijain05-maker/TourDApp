<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<Dialog id="confirmDialog" title="{i18n>confirmTitle}" type="Message" state="Warning">
		<content>
			<Text text="{i18n>confirmText}" />
		</content>
		<beginButton>
			<Button id="confirmBtn" type="Reject" text="{i18n>delete}" press=".onConfirmDelete" />
		</beginButton>
		<endButton>
			<Button id="cancelBtn" text="{i18n>cancel}" press=".onCancelDelete" />
		</endButton>
	</Dialog>
</core:FragmentDefinition>
