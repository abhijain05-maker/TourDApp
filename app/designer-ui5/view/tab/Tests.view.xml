<mvc:View
	controllerName="tourd.designer.controller.tab.Tests"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc">
	<VBox class="tourdStack sapUiSmallMargin" renderType="Bare">
		<HBox justifyContent="SpaceBetween" wrap="Wrap" alignItems="Center">
			<VBox renderType="Bare">
				<Title text="{i18n>tabTests}" level="H4" />
				<Text text="{i18n>testsIntro}" class="tourdMuted" />
			</VBox>
			<Button id="newTestPlan" text="{i18n>testsNew}" icon="sap-icon://add" type="Emphasized" enabled="{= !${view>/noRecording}}" press=".onNew" />
		</HBox>
		<MessageStrip id="needRecording" type="Information" showIcon="true" text="{i18n>toursNeedRecording}" visible="{view>/noRecording}">
			<link><Link text="{i18n>toursImportOne}" press=".onNeedRecording" /></link>
		</MessageStrip>
		<MessageStrip type="Error" showIcon="true" text="{view>/error}" visible="{= !!${view>/error}}" />
		<Table id="testsTable" items="{view>/plans}" busy="{view>/loading}" noDataText="{i18n>testsNone}" class="tourdCard" width="100%">
			<columns>
				<Column><Text text="{i18n>colName}" /></Column>
				<Column width="6rem"><Text text="{i18n>testsSteps}" /></Column>
				<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>testsFramework}" /></Column>
				<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>testsLogin}" /></Column>
				<Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colChanged}" /></Column>
				<Column width="4rem" hAlign="End" />
			</columns>
			<items>
				<ColumnListItem type="Navigation" press=".onOpen">
					<cells>
						<Text text="{view>name}" class="tourdBold" />
						<Text text="{view>steps}" />
						<ObjectStatus text="{view>frameworkText}" state="Success" />
						<Text text="{view>authText}" />
						<Text text="{view>changedText}" />
						<Button icon="sap-icon://delete" type="Transparent" tooltip="{i18n>testsDelete}" press=".onDelete" />
					</cells>
				</ColumnListItem>
			</items>
		</Table>
	</VBox>
</mvc:View>
