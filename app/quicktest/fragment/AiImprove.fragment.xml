<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<Dialog id="aiImproveDialog" title="{i18n>aiImproveTitle}" icon="sap-icon://ai" contentWidth="62rem" stretchOnPhone="true" resizable="true" draggable="true">
		<content>
			<VBox class="sapUiSmallMargin qtStack" renderType="Bare" busy="{ai>/busy}" busyIndicatorDelay="0">
				<HBox alignItems="Center">
					<core:Icon src="sap-icon://ai" class="sapUiTinyMarginEnd" color="{= ${ai>/ai} ? 'Marker' : 'Default'}" />
					<Text text="{ai>/mode}" class="qtMuted" />
				</HBox>
				<MessageStrip type="Warning" showIcon="true" text="{i18n>aiImproveNeedsAi}" visible="{= !${ai>/ai}}" />
				<MessageStrip type="Error" showIcon="true" text="{ai>/error}" visible="{= !!${ai>/error}}" />
				<HBox visible="{ai>/ai}">
					<Input id="aiImproveInstruction" value="{ai>/instruction}" valueLiveUpdate="true" placeholder="{i18n>aiImprovePlaceholder}" submit=".onRun" class="qtGrow sapUiTinyMarginEnd" />
					<Button id="aiImproveRun" text="{i18n>aiTryAgain}" icon="sap-icon://refresh" enabled="{= !${ai>/busy}}" press=".onRun" />
				</HBox>
				<HBox class="qtTwoCols" renderType="Bare">
					<VBox class="qtCard qtPadded" renderType="Bare">
						<Text text="{i18n>aiCurrent}" class="qtSectionTitle" />
						<Text text="{ai>/current}" renderWhitespace="true" />
					</VBox>
					<VBox class="qtCard qtPadded" renderType="Bare">
						<Text text="{i18n>aiProposal}" class="qtSectionTitle" />
						<Text id="aiImproveAfter" text="{= ${ai>/after} || ${i18n>aiNoProposal}}" renderWhitespace="true" />
					</VBox>
				</HBox>
				<Text text="{i18n>aiImproveHint}" class="qtMuted" />
			</VBox>
		</content>
		<beginButton>
			<Button id="aiImproveApply" text="{i18n>aiUseProposal}" type="Emphasized" icon="sap-icon://accept" enabled="{= !!${ai>/proposal}}" press=".onApply" />
		</beginButton>
		<endButton>
			<Button id="aiImproveClose" text="{i18n>cancel}" press=".onClose" />
		</endButton>
	</Dialog>
</core:FragmentDefinition>
