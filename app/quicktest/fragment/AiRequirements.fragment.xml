<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" core:require="{Format: 'quicktest/util/Format'}">
	<Dialog id="aiRequirementsDialog" title="{i18n>aiReqTitle}" icon="sap-icon://ai" contentWidth="54rem" contentHeight="40rem" stretchOnPhone="true" resizable="true" draggable="true">
		<content>
			<VBox class="sapUiSmallMargin qtStack" renderType="Bare" busy="{ai>/busy}" busyIndicatorDelay="0">
				<HBox alignItems="Center">
					<core:Icon src="sap-icon://ai" class="sapUiTinyMarginEnd" color="{= ${ai>/ai} ? 'Marker' : 'Default'}" />
					<Text text="{ai>/mode}" class="qtMuted" />
				</HBox>
				<MessageStrip type="Error" showIcon="true" text="{ai>/error}" visible="{= !!${ai>/error}}" />
				<Label text="{i18n>aiReqText}" labelFor="aiReqText" />
				<TextArea id="aiReqText" value="{ai>/text}" valueLiveUpdate="true" rows="5" width="100%" placeholder="{i18n>aiReqPlaceholder}" />
				<Input id="aiReqInstruction" value="{ai>/instruction}" valueLiveUpdate="true" placeholder="{i18n>aiInstruction}" visible="{ai>/ai}" />
				<HBox alignItems="Center">
					<Button id="aiReqDraft" text="{= ${ai>/ai} ? ${i18n>aiDraftAi} : ${i18n>aiDraftRules}}" icon="sap-icon://ai" type="Emphasized" enabled="{= ${ai>/text}.length > 7 &amp;&amp; !${ai>/busy}}" press=".onDraft" />
				</HBox>
				<MessageStrip type="Information" showIcon="true" text="{ai>/note}" visible="{= !!${ai>/note}}" />

				<VBox visible="{= ${ai>/items}.length > 0}" renderType="Bare">
					<HBox alignItems="Center" justifyContent="SpaceBetween">
						<Title text="{i18n>aiReview}" level="H5" />
						<CheckBox text="{i18n>aiAll}" selected="{ai>/all}" select=".onAll" />
					</HBox>
					<Text text="{i18n>aiReviewHint}" class="qtMuted sapUiTinyMarginBottom" />
					<VBox id="aiReqList" items="{ai>/items}" class="qtCard qtReviewList" renderType="Bare">
						<HBox class="qtReviewItem">
							<CheckBox selected="{ai>selected}" select=".onTick" />
							<VBox class="qtGrow" renderType="Bare">
								<Input value="{ai>title}" valueLiveUpdate="true" />
								<Text text="{ai>description}" class="qtMuted sapUiTinyMarginTop" visible="{= !!${ai>description}}" />
								<VBox items="{path: 'ai>criteriaList', templateShareable: false}" renderType="Bare" class="sapUiTinyMarginTop">
									<Text text="{= '• ' + ${ai>}}" />
								</VBox>
							</VBox>
							<VBox renderType="Bare" alignItems="End">
								<ObjectStatus text="{path: 'ai>priority', formatter: 'Format.priorityText'}" state="{path: 'ai>priority', formatter: 'Format.priorityState'}" />
								<Text text="{path: 'ai>kind', formatter: 'Format.reqKindText'}" class="qtMuted" />
							</VBox>
						</HBox>
					</VBox>
				</VBox>
			</VBox>
		</content>
		<beginButton>
			<Button id="aiReqSave" text="{i18n>aiSaveSelected}" type="Emphasized" icon="sap-icon://save" enabled="{= ${ai>/chosen} > 0 &amp;&amp; !${ai>/busy}}" press=".onSave" />
		</beginButton>
		<endButton>
			<Button id="aiReqClose" text="{i18n>close}" press=".onClose" />
		</endButton>
	</Dialog>
</core:FragmentDefinition>
