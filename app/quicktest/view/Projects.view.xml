<mvc:View
	controllerName="quicktest.controller.Projects"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.f"
	xmlns:grid="sap.ui.layout.cssgrid"
	xmlns:qt="quicktest.control"
	core:require="{Format: 'quicktest/util/Format'}">
	<Page id="projectsPage" showHeader="false" enableScrolling="true" class="qtPageBg">
		<content>
			<VBox class="qtPage" renderType="Bare">
				<Toolbar class="qtToolbar">
					<Title text="{i18n>projectsTitle}" level="H2" />
					<ToolbarSpacer />
					<Button id="newProject" text="{i18n>newProject}" icon="sap-icon://add" type="Emphasized" press=".onNew" />
				</Toolbar>
				<Text text="{i18n>projectsIntro}" class="qtMuted sapUiSmallMarginBottom" />
				<MessageStrip type="Error" showIcon="true" text="{view>/error}" visible="{= !!${view>/error}}" class="sapUiSmallMarginBottom" />

				<VBox visible="{= !${view>/busy} &amp;&amp; ${view>/projects}.length === 0}" class="qtCard qtEmptyNote" renderType="Bare">
					<core:Icon src="sap-icon://task" size="2.5rem" class="qtMuted" />
					<Title text="{i18n>noProjects}" level="H4" class="sapUiSmallMarginTop" />
					<Text text="{i18n>noProjectsHint}" class="qtMuted sapUiTinyMarginTop" />
				</VBox>

				<f:GridList id="projectList" items="{view>/projects}" busy="{view>/busy}" mode="None" showNoData="false">
					<f:customLayout>
						<grid:GridBoxLayout boxWidth="24rem" />
					</f:customLayout>
					<f:GridListItem type="Active" press=".onOpen" class="qtProjectItem">
						<VBox class="sapUiSmallMargin" renderType="Bare">
							<HBox alignItems="Center" justifyContent="SpaceBetween">
								<HBox alignItems="Center">
									<Text text="{path: 'view>name', formatter: 'Format.initial'}" class="qtAvatar sapUiSmallMarginEnd" />
									<VBox renderType="Bare">
										<Title text="{view>name}" level="H4" wrapping="true" />
										<Text text="{= ${view>appId} || ${view>description} || ''}" class="qtMuted" maxLines="1" />
									</VBox>
								</HBox>
								<Button icon="sap-icon://delete" type="Transparent" tooltip="{i18n>deleteProject}" press=".onDelete" />
							</HBox>
							<HBox class="qtNums" alignItems="Center" wrap="Wrap">
								<qt:ProgressRing size="4.5rem" value="{view>coverageValue}" caption="{i18n>cardCoverage}" state="{view>coverageState}" class="sapUiSmallMarginEnd" />
								<qt:ProgressRing size="4.5rem" value="{view>automationValue}" caption="{i18n>cardAutomated}" state="None" class="sapUiSmallMarginEnd" />
								<qt:ProgressRing size="4.5rem" value="{view>passValue}" caption="{i18n>cardPassed}" state="{view>passState}" />
							</HBox>
							<HBox class="qtNums" justifyContent="SpaceBetween">
								<VBox class="qtNum" renderType="Bare"><Text text="{view>requirements}" class="qtNumValue" /><Text text="{i18n>cardRequirements}" class="qtNumLabel" /></VBox>
								<VBox class="qtNum" renderType="Bare"><Text text="{view>cases}" class="qtNumValue" /><Text text="{i18n>cardCases}" class="qtNumLabel" /></VBox>
								<VBox class="qtNum" renderType="Bare"><Text text="{view>runs}" class="qtNumValue" /><Text text="{i18n>cardRuns}" class="qtNumLabel" /></VBox>
							</HBox>
							<ObjectStatus text="{view>failingText}" state="Error" icon="sap-icon://error" visible="{= ${view>failing} > 0}" class="sapUiTinyMarginTop" />
						</VBox>
					</f:GridListItem>
				</f:GridList>
			</VBox>
		</content>
	</Page>
</mvc:View>
